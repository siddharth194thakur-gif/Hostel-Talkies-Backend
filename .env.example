# Django Secret Key & Debug Mode
DJANGO_SECRET_KEY=your-secure-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (PostgreSQL URL for Render/Production, leave blank for SQLite)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://hostel-talkies.vercel.app,https://hostel-talkies-frontend.vercel.app

# Email SMTP Settings (For notifications & contact)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=HostelTalkies <no-reply@hosteltalkies.com>

# Free Fire Player Profile API Provider (Optional: for custom or third-party paid/dedicated endpoint)
FREEFIRE_API_BASE_URL=
FREEFIRE_API_KEY=
